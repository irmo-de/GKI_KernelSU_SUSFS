diff --git a/kernel/feature/selinux_hide.c b/kernel/feature/selinux_hide.c
index aa42c136..ab202d9f 100644
--- a/kernel/feature/selinux_hide.c
+++ b/kernel/feature/selinux_hide.c
@@ -140,6 +140,24 @@ void ksu_selinux_hide_drop_backup_if_unused()
 	mutex_unlock(&selinux_hide_mutex);
 }
 
+void ksu_selinux_hide_auto_enable(void)
+{
+    int ret;
+    pr_info("selinux_hide: auto-enabling selinux hide\n");
+    mutex_lock(&selinux_hide_mutex);
+    ksu_selinux_hide_enabled = true;
+    if (!ksu_selinux_hide_running) {
+        ret = ksu_selinux_hide_enable();
+        if (!ret) {
+            ksu_selinux_hide_running = true;
+            pr_info("selinux_hide: auto-enabled successfully\n");
+        } else {
+            pr_err("selinux_hide: auto-enable failed: %d\n", ret);
+        }
+    }
+    mutex_unlock(&selinux_hide_mutex);
+}
+
 #if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 6, 0)
 /*
  * Caveat:  Mutates scontext.
diff --git a/kernel/feature/selinux_hide.h b/kernel/feature/selinux_hide.h
index bdbe4151..a10d9155 100644
--- a/kernel/feature/selinux_hide.h
+++ b/kernel/feature/selinux_hide.h
@@ -4,5 +4,6 @@
 void ksu_selinux_hide_init();
 void ksu_selinux_hide_exit();
 void ksu_selinux_hide_drop_backup_if_unused();
+void ksu_selinux_hide_auto_enable();
 
 #endif
diff --git a/kernel/selinux/rules.c b/kernel/selinux/rules.c
index de3b940b..2ce46cca 100644
--- a/kernel/selinux/rules.c
+++ b/kernel/selinux/rules.c
@@ -15,6 +15,8 @@
 #include "linux/lsm_audit.h" // IWYU pragma: keep
 #include "xfrm.h"
 
+#include "feature/selinux_hide.h"
+
 struct selinux_policy *backup_sepolicy;
 
 #define SELINUX_POLICY_INSTEAD_SELINUX_SS
@@ -148,6 +150,7 @@ void apply_kernelsu_rules()
 	synchronize_rcu();
 	ksu_destroy_sepolicy(old_pol);
 
+	ksu_selinux_hide_auto_enable();
 	reset_avc_cache();
 
 	susfs_set_batch_sid();
