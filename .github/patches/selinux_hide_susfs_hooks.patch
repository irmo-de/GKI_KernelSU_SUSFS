diff --git a/kernel/feature/selinux_hide.c b/kernel/feature/selinux_hide.c
--- a/kernel/feature/selinux_hide.c
+++ b/kernel/feature/selinux_hide.c
@@ -287,8 +287,8 @@
 
     ret = ksu_lsm_hook(&selinux_setprocattr_hook);
     if (ret) {
-        pr_err("selinux_hide: init: selinux_setprocattr_hook err: %d\n", ret);
-        goto unhook;
+        pr_warn("selinux_hide: setprocattr hook failed (%d); access/context hooks remain active\n", ret);
+        ret = 0;
     }
 
     return 0;
@@ -397,6 +397,24 @@
     mutex_unlock(&selinux_hide_mutex);
 }
 
+void ksu_selinux_hide_auto_enable(void)
+{
+    int ret;
+    pr_info("selinux_hide: auto-enabling selinux hide\n");
+    mutex_lock(&selinux_hide_mutex);
+    ksu_selinux_hide_enabled = true;
+    if (!ksu_selinux_hide_running) {
+        ret = ksu_selinux_hide_enable();
+        if (!ret) {
+            ksu_selinux_hide_running = true;
+            pr_info("selinux_hide: auto-enabled successfully\n");
+        } else {
+            pr_err("selinux_hide: auto-enable failed: %d\n", ret);
+        }
+    }
+    mutex_unlock(&selinux_hide_mutex);
+}
+
 #if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 6, 0)
 /*
