+/*
+ * Compiled-in hook (called directly from the patched common selinux_setprocattr),
+ * NOT via lsm_hook (which bootloops this SUSFS kernel). Closes DirtySepolicy's
+ * contextExists() fallback that writes /proc/self/attr/current: for an app
+ * setting "current" to a context absent from the clean backup policy, report
+ * -EINVAL so the context appears not to exist. Returns 0 to proceed normally.
+ */
+int ksu_selinux_hide_intercept_setprocattr(const char *name, void *value, size_t size)
+{
+    u32 sid;
+    int rc;
+    size_t len;
+    char *str = value;
+
+    if (!ksu_selinux_hide_running || !backup_sepolicy)
+        return 0;
+    if (current_uid().val < 10000)
+        return 0;
+    if (!name || strcmp(name, "current") != 0)
+        return 0;
+    if (!size || !str || !str[0] || str[0] == '\n')
+        return 0;
+    len = size;
+    if (str[len - 1] == '\n')
+        len--;
+    if (!len)
+        return 0;
+    if (ksu_selinux_hide_private_context(str, len))
+        return -EINVAL;
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 6, 0)
+    rc = security_context_to_sid_with_policy(backup_sepolicy, str, len, &sid, SECSID_NULL, GFP_KERNEL);
+#else
+    rc = security_context_to_sid(&fake_state, str, len, &sid, GFP_KERNEL);
+#endif
+    if (rc == -EINVAL)
+        return -EINVAL;
+    return 0;
+}
+
+/*
+ * Status-page hiding (sequence/policyload). DirtySepolicy reads
+ * /sys/fs/selinux/status; KSU's avc resets bump 'sequence' without bumping
+ * 'policyload', and that mismatch is the tell. We hook sel_handle_status_ops.open
+ * (function-pointer slot patched via ksu_patch_text - same safe primitive as the
+ * write_op hooks, NOT lsm_hook) and hand apps a frozen page with a consistent
+ * (policyload=1, sequence=4) pair. .read and .mmap both use filp->private_data,
+ * which .open sets, so hooking .open alone covers both.
+ */
+static struct page *ksu_fake_status = NULL;
+typedef int (*ksu_status_open_fn)(struct inode *, struct file *);
+static ksu_status_open_fn ksu_orig_status_open, *ksu_status_open_slot;
+
+static void ksu_init_fake_status(void)
+{
+    struct page *page;
+    struct selinux_kernel_status *real, *fake;
+
+    mutex_lock(&selinux_state.status_lock);
+    if (ksu_fake_status)
+        goto out;
+    if (!selinux_state.status_page)
+        goto out;
+    page = alloc_page(GFP_KERNEL | __GFP_ZERO);
+    if (!page)
+        goto out;
+    real = page_address(selinux_state.status_page);
+    fake = page_address(page);
+    memcpy(fake, real, sizeof(*fake));
+    fake->version = SELINUX_KERNEL_STATUS_VERSION;
+    fake->enforcing = 1;
+    fake->deny_unknown = 1;
+    fake->policyload = 1;
+    fake->sequence = 4;
+    ksu_fake_status = page;
+    pr_info("selinux_hide: fake status seq=%u policyload=%u enforcing=%u\n", fake->sequence, fake->policyload,
+            fake->enforcing);
+out:
+    mutex_unlock(&selinux_state.status_lock);
+}
+
+static int ksu_my_status_open(struct inode *inode, struct file *filp)
+{
+    if (current_uid().val >= 10000 && ksu_selinux_hide_running) {
+        void *data;
+        if (!ksu_fake_status)
+            ksu_init_fake_status();
+        mutex_lock(&selinux_state.status_lock);
+        data = ksu_fake_status;
+        mutex_unlock(&selinux_state.status_lock);
+        if (data) {
+            filp->private_data = data;
+            return 0;
+        }
+    }
+    return ksu_orig_status_open(inode, filp);
+}
+
+static void ksu_hook_status_open(void)
+{
+    struct file_operations *ops;
+    ksu_status_open_fn my = ksu_my_status_open;
+    int ret;
+
+    if (ksu_orig_status_open)
+        return;
+    ops = (struct file_operations *)kallsyms_lookup_name("sel_handle_status_ops");
+    if (!ops) {
+        pr_warn("selinux_hide: sel_handle_status_ops not found; status not hidden\n");
+        return;
+    }
+    ksu_status_open_slot = &ops->open;
+    ksu_orig_status_open = *ksu_status_open_slot;
+    ret = ksu_patch_text(ksu_status_open_slot, &my, sizeof(my), KSU_PATCH_TEXT_FLUSH_DCACHE);
+    if (ret) {
+        pr_err("selinux_hide: patch sel_handle_status_ops.open err %d\n", ret);
+        ksu_status_open_slot = NULL;
+        ksu_orig_status_open = NULL;
+    } else {
+        pr_info("selinux_hide: hooked sel_handle_status_ops.open\n");
+    }
+}
